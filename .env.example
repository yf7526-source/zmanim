# These values are public identifiers embedded in the browser build.
# Do not place private API keys or secrets in VITE_* variables.
VITE_BASE44_APP_ID=your_base44_app_id
VITE_BASE44_APP_BASE_URL=https://your-app-name.base44.app

# Optional: set this only if your Base44 project uses a pinned functions version.
VITE_BASE44_FUNCTIONS_VERSION=

# Optional HTTPS endpoint that accepts privacy-scrubbed client error reports.
# Leave blank to disable outbound error reporting.
VITE_ERROR_REPORTING_URL=

# Optional release label shown in error reports, e.g. 2026.08.26.1.
VITE_APP_VERSION=
